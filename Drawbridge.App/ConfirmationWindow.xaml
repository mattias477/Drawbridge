<Window x:Class="Drawbridge.App.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="13"
            Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.48" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="#3AF05B68">
                    <TextBlock Text="!" Foreground="{StaticResource DangerBrush}" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,18,0,0" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13" TextWrapping="Wrap" LineHeight="20" />

            <StackPanel x:Name="PhrasePanel" Grid.Row="2" Margin="0,18,0,0">
                <TextBlock x:Name="PhraseHintText" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                <TextBox x:Name="PhraseTextBox" TextChanged="PhraseTextBox_OnTextChanged" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,23,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="92" Margin="0,0,10,0" Click="Cancel_OnClick" />
                <Button x:Name="ConfirmButton" Content="Continue" Style="{StaticResource DangerButton}" MinWidth="108" Click="Confirm_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
